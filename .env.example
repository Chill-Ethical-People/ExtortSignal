# Set to 0 to prevent automatic public-feed polling.
RANSOM_MONITOR_AUTO_COLLECT=1

# Minimum 60 seconds. The default is deliberately conservative.
RANSOM_MONITOR_COLLECT_INTERVAL=120

# HTTP timeout for public feeds.
RANSOM_MONITOR_TIMEOUT=20

# Historical imports return larger payloads and need a longer timeout.
RANSOM_MONITOR_BACKFILL_TIMEOUT=120

# Optional alternate local data directory.
# RANSOM_MONITOR_DATA_DIR=/absolute/path/to/private/data

# Host headers accepted by the localhost API. Keep the defaults for a local-only
# deployment. If an authenticated reverse proxy is intentionally used, add only
# its exact public hostname here.
# EXTORTSIGNAL_TRUSTED_HOSTS=127.0.0.1,localhost,::1

# Custom AI endpoints are limited to loopback by default. List exact HTTPS
# hostnames only when an administrator has reviewed and approved those
# destinations. Do not add cloud metadata or broad private-network ranges.
# EXTORTSIGNAL_TRUSTED_CUSTOM_AI_HOSTS=

# SMTP accepts public hostnames and loopback by default. List exact private mail
# relay hostnames here only when they are an intended deployment dependency.
# EXTORTSIGNAL_TRUSTED_PRIVATE_SMTP_HOSTS=

# Dedicated secret that enables the isolated Kali screenshot worker.
# Generate at least 32 random bytes; never commit the real value.
EXTORTSIGNAL_CAPTURE_WORKER_TOKEN=
EXTORTSIGNAL_CAPTURE_WORKER_ENABLED=0
# Authenticated loopback control plane used by the separate worker process.
# EXTORTSIGNAL_CAPTURE_WORKER_API_URL=http://127.0.0.1:8765

# Optional capture overrides. The Kali installer discovers Chromium and uses
# the local Tor SOCKS proxy by default.
# EXTORTSIGNAL_CHROMIUM_PATH=/usr/bin/chromium
# EXTORTSIGNAL_TOR_PROXY=socks5://127.0.0.1:9050
# EXTORTSIGNAL_CAPTURE_TIMEOUT=90
# Maximum lazy-load scroll passes, delay per pass, and rendered page height.
# EXTORTSIGNAL_CAPTURE_MAX_SCROLLS=60
# EXTORTSIGNAL_CAPTURE_SCROLL_DELAY_MS=1000
# EXTORTSIGNAL_CAPTURE_MAX_PAGE_HEIGHT=50000
# Review-friendly PNG page height. Captures use an 80 px overlap so content at
# a page boundary remains visible in at least one segment.
# EXTORTSIGNAL_CAPTURE_SEGMENT_HEIGHT=1400
# Local text extraction: auto uses DOM text first and invokes Tesseract when
# the page exposes little text. Set always to retain DOM plus OCR, or off to
# disable OCR while keeping DOM extraction.
# EXTORTSIGNAL_CAPTURE_OCR_MODE=always
# EXTORTSIGNAL_TESSERACT_PATH=/usr/bin/tesseract
# EXTORTSIGNAL_CAPTURE_OCR_TIMEOUT=180

# Optional AI enrichment credentials. Values can be supplied through the
# environment or saved through Settings in the ignored, permission-restricted
# data/secrets.json store. Ollama does not require a key.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
